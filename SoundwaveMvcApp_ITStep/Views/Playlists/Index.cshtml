﻿@{
    ViewData["Title"] = "Playlists";
}
@model List<PlaylistDto>

<div class="d-flex align-items-center justify-content-center mb-2">
    <h1 class="text-white text-center me-3">Playlists</h1>
    <a asp-controller="Playlists" asp-action="Create" class="btn btn-outline-light"><i class="bi bi-plus-circle"></i></a>
</div>


@if (Model.Any())
{
    @foreach (var playlist in Model)
    {
        <div class="text-white">@playlist.Id - @playlist.Title | @playlist.UserName - @playlist.UserId | @playlist.Tracks.Count</div>
        <a asp-controller="Playlists" asp-action="ShowPlaylist" asp-route-playlistId="@playlist.Id">Show @playlist.Title</a>
        <a asp-controller="Playlists" asp-action="Edit" asp-route-id="@playlist.Id">Edit @playlist.Title</a>
        <a asp-controller="Playlists" asp-action="Delete" asp-route-id="@playlist.Id" asp-route-returnUrl="@Context.Request.Path">Delete @playlist.Title</a>
    }
}
else
{
    <div class="text-secondary text-center">
        <p class="mb-0">It looks like you don't have any playlists yet.</p>
        <p>Create one, explore the home page, find tracks you like and add them to playlists!</p>
    </div>
}