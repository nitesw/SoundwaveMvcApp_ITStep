﻿@{
    ViewData["Title"] = "Playlists";
}
@model List<PlaylistDto>

<div class="d-flex align-items-center justify-content-center mb-2">
    <h1 class="text-white text-center me-3">Playlists</h1>
    <a asp-controller="Playlists" asp-action="Create" class="btn btn-outline-light"><i class="bi bi-plus-circle"></i></a>
</div>


@if (Model.Any())
{
    <div class="container">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 mt-4 g-4">
            @foreach (var item in Model)
            {
                <partial name="_PlaylistsPartial" model="@item" />
            }
        </div>
    </div>
}
else
{
    <div class="text-secondary text-center">
        <p class="mb-0">It looks like you don't have any playlists yet.</p>
        <p>Create one, explore the home page, find tracks you like and add them to playlists!</p>
    </div>
}

