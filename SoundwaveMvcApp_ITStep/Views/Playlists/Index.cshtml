@model List<PlaylistDto>

<h1 class="text-white text-center mb-3">Playlists</h1>

@if(Model.Any())
{
    @foreach (var playlist in Model)
    {
        <div class="text-white">@playlist.Id - @playlist.UserName</div>
    }
}
else
{
    <div class="text-secondary text-center">
        <p class="mb-0">It looks like you don't have any playlists yet.</p>
        <p>Explore the home page and find tracks you like and add them to playlists!</p>
    </div>
}