@{
    ViewData["Title"] = "Users";
}
@model List<User>

<table class="table table-dark">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Username</th>
            <th scope="col">Email</th>
            <th scope="col">PasswordHash</th>
            <th scope="col">PhoneNumber</th>
            <th scope="col">TrackCount</th>
            <th scope="col">PlaylistCount</th>
            @* <th scope="col">Comments</th>
            <th scope="col">Follows</th>
            <th scope="col">Uploaded Tracks</th> *@
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <th scope="row">
                    <span title="@user.Id">@user.Id.Substring(0, 5)...</span>
                </th>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <span title="@user.PasswordHash">@user.PasswordHash!.Substring(0, 5)...</span>
                </td>
                <td>@(user.PhoneNumber != null ? user.PhoneNumber : "-")</td>
                <td>@user.TrackCount</td>
                <td>@user.PlaylistCount</td>
                @* <td>@user.Username</td>
                <td>@user.Email</td>
                <td>@user.Password</td>
                <td>@user.Likes</td>
                <td>@user.Playlists</td> *@
            </tr>
        } 
    </tbody>
</table>